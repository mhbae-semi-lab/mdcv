# MDCV self-host settings. Copy to .env (never commit .env). Empty values = feature off.
# --- LLM (optional: without it everything runs on rules) ---
# anthropic | openai | gemini
MDCV_LLM_PROVIDER=
MDCV_LLM_API_KEY=
# empty = provider default (anthropic: claude-opus-5-5)
MDCV_LLM_MODEL=
MDCV_LLM_DAILY_LIMIT=200
MDCV_LLM_MAX_CHARS=4000
# --- Alerts (optional) ---
MDCV_TEAMS_WEBHOOK=
MDCV_KAKAO_TOKEN=
# --- Mail accounts: register your own OAuth apps (docs/oauth-setup-guide.md) ---
MDCV_GRAPH_CLIENT_ID=
MDCV_GRAPH_CLIENT_SECRET=
MDCV_GMAIL_CLIENT_ID=
MDCV_GMAIL_CLIENT_SECRET=
# Reply sending is off unless set to 1; only then is Mail.Send / gmail.send requested.
MDCV_ENABLE_SEND=
# --- Encryption at rest (tokens and mail bodies, AES-256-GCM) ---
# Empty = a random key file (mdcv.key) is created next to the DB. Back it up with the DB.
MDCV_SECRET=
# --- Access ---
# 127.0.0.1 = this PC only. For other PCs use 0.0.0.0 behind HTTPS and set MDCV_API_TOKEN.
MDCV_HOST=127.0.0.1
MDCV_API_TOKEN=
MDCV_CORS_ORIGINS=
# --- Operation ---
MDCV_SYNC_MINUTES=10
MDCV_LOG_LEVEL=INFO
MDCV_API_BASE=http://localhost:8000
MDCV_WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
